# ==========================================================
# CONFIGURAÇÕES ESPECÍFICAS PARA ENVIO VIA SMS (ADB)
# ==========================================================
# Esse arquivo (.env.sms) serve para desvincular as amarras
# de tempo do WhatsApp, já que as restrições da operadora
# de telefonia são diferentes e mais rigorosas.
# ==========================================================

# ─── DELAYS BASE (Em segundos) ─────────────────────────────
# Tempo mínimo e máximo que o robô vai esperar entre 
# o envio de um SMS e outro.
# Recomendado para proteger o chip de operadora: 10 a 25
SMS_DELAY_MIN=10
SMS_DELAY_MAX=25

# ─── SISTEMA DE BLOCOS ─────────────────────────────────────
# A cada X mensagens enviadas (SMS_BLOCK_SIZE), o robô fará uma
# pausa longa de Y segundos (SMS_BLOCK_PAUSE) para diluir
# a quantia total diária (ex: 1200 msgs) ao longo das horas.
# Para ~1200 SMS/dia, Recomendado: 60 mensagens / 1200 segundos (20 min)
SMS_BLOCK_SIZE=60
SMS_BLOCK_PAUSE=1200

# ─── MODO AQUECIMENTO (WARMUP) ─────────────────────────────
# Limita o envio diário caso o chip seja totalmente novo
SMS_WARMUP_MODE=false
SMS_WARMUP_DELAY_MIN=25
SMS_WARMUP_DELAY_MAX=45
SMS_WARMUP_DAILY_LIMIT=150

# ─── COORDENADAS DO BOTÃO ENVIAR NO APP DE SMS ─────────────
# Ajuste conforme a resolução da tela do dispositivo Android conectado via ADB
SMS_TAP_X=653
SMS_TAP_Y=1452
