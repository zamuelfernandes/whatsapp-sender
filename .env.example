# ==========================================================
# CONFIGURAÇÕES DO WHATSAPP SENDER
# ==========================================================
# IMPORTANTE: Este é um arquivo de exemplo.
# Duplique este arquivo, renomeie para ".env" e 
# ajuste os valores abaixo conforme sua estratégia de envio.
# ==========================================================

# ─── DELAYS BASE (Em segundos) ─────────────────────────────
# Tempo mínimo e máximo que o robô vai esperar entre 
# o envio de uma mensagem e outra (Sorteio aleatório).
# Recomendado para números quentes: 20 a 45
DELAY_MIN=20
DELAY_MAX=45

# ─── SISTEMA DE BLOCOS ─────────────────────────────────────
# A cada X mensagens enviadas (BLOCK_SIZE), o robô fará uma
# pausa longa de Y segundos (BLOCK_PAUSE) para simular
# a inatividade humana (ex: ir ao banheiro, tomar café).
# Recomendado: 40 mensagens / 180 segundos (3 minutos)
BLOCK_SIZE=40
BLOCK_PAUSE=180

# ─── MODO AQUECIMENTO (WARMUP) ─────────────────────────────
# Útil apenas se a conta for COMPLETAMENTE NOVA.
# Limita o envio diário e dobra o tempo de espera.
WARMUP_MODE=false
WARMUP_DELAY_MIN=40
WARMUP_DELAY_MAX=80
WARMUP_DAILY_LIMIT=30

# ─── SERVIDOR E NAVEGADOR (PUPPETEER) ──────────────────────
# Porta inicial do painel web (usa a próxima livre se estiver ocupada)
PORT=3000
# true = roda oculto em segundo plano | false = exibe a janela do Chrome
WA_HEADLESS=true
